<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localize="clr-namespace:EngineeringSupporter.Resources.Localize"
             x:Class="EngineeringSupporter.Controls.TodoView"
             HorizontalOptions="FillAndExpand"
             VerticalOptions="FillAndExpand">
    <ContentView.Resources>
        <Style x:Key="HeaderLabelStyle" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#2B2F33 Dark=#E5E7EB}" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
        <Style x:Key="CellLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#4A4F55 Dark=#D1D5DB}" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
    </ContentView.Resources>

    <Grid x:Name="LayoutRoot" RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="14" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <VerticalStackLayout x:Name="HeaderBlock" Spacing="4">
            <Label Text="{x:Static localize:Resources.todo_header_title}" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2A33 Dark=#F3F4F6}" />
            <Label Text="{x:Static localize:Resources.todo_header_subtitle}" FontSize="12" TextColor="{AppThemeBinding Light=#6B7280 Dark=#9CA3AF}" />
        </VerticalStackLayout>

        <Border x:Name="TableBorder" Grid.Row="1" Stroke="{AppThemeBinding Light=#E5E7EB Dark=#2B2F33}" BackgroundColor="{AppThemeBinding Light=#FFFFFF Dark=#121416}" StrokeThickness="1" VerticalOptions="FillAndExpand">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Offset="0,4" Opacity="0.12" Radius="12" />
            </Border.Shadow>
            <Grid x:Name="TableGrid" RowDefinitions="Auto,*" Padding="12" RowSpacing="8" VerticalOptions="FillAndExpand">
                <Grid Padding="6">
                    <HorizontalStackLayout
                        x:Name="TableHeader"
                        Spacing="10"
                        BindableLayout.ItemsSource="{Binding Columns}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="10,8"
                                    BackgroundColor="{AppThemeBinding Light=#F3F4F6 Dark=#1F2327}"
                                    Stroke="{AppThemeBinding Light=#E5E7EB Dark=#2B2F33}"
                                    StrokeThickness="1"
                                    WidthRequest="{Binding Width}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="8" />
                                    </Border.StrokeShape>
                                    <Label Style="{StaticResource HeaderLabelStyle}" Text="{Binding Title}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </Grid>

                <ScrollView Grid.Row="1"
                            Orientation="Both"
                            HorizontalScrollBarVisibility="Always"
                            VerticalScrollBarVisibility="Always"
                            VerticalOptions="FillAndExpand">
                    <VerticalStackLayout
                        x:Name="RowsView"
                        Spacing="8"
                        BindableLayout.ItemsSource="{Binding Rows}"
                        Margin="0,0,0,6"
                        VerticalOptions="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="6"
                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF Dark=#121416}"
                                    Stroke="{AppThemeBinding Light=#EEF2F6 Dark=#1F2428}"
                                    StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="10" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Offset="0,2" Opacity="0.06" Radius="6" />
                                    </Border.Shadow>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsBehindSchedule}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FCE8E8 Dark=#3A1F1F}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light=#F3B7B7 Dark=#5A2A2A}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsAheadSchedule}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8F7EE Dark=#153428}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light=#BFE7CF Dark=#1F4A38}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <HorizontalStackLayout
                                        Spacing="10"
                                        BindableLayout.ItemsSource="{Binding Cells}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Padding="10,8"
                                                    BackgroundColor="{AppThemeBinding Light=#FFFFFF Dark=#15181B}"
                                                    Stroke="{AppThemeBinding Light=#EEF2F6 Dark=#24282C}"
                                                    StrokeThickness="1"
                                                    WidthRequest="{Binding Width}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8" />
                                                    </Border.StrokeShape>
                                                    <Grid>
                                                        <Label x:Name="CellLabel" Style="{StaticResource CellLabelStyle}" Text="{Binding DisplayText}" />
                                                        <Entry x:Name="CellEntry"
                                                               Text="{Binding DisplayText}"
                                                               IsVisible="False"
                                                               Keyboard="Numeric"
                                                               Unfocused="OnProgressEntryUnfocused"
                                                               TextColor="{AppThemeBinding Light=#1F2A33 Dark=#F3F4F6}"
                                                               PlaceholderColor="{AppThemeBinding Light=#9CA3AF Dark=#6B7280}" />
                                                        <Button x:Name="CellDeleteButton"
                                                                Text="{x:Static localize:Resources.todo_table_action_delete}"
                                                                Command="{Binding Command}"
                                                                IsVisible="False"
                                                                BackgroundColor="{AppThemeBinding Light=#FCE8E8 Dark=#3A1F1F}"
                                                                TextColor="{AppThemeBinding Light=#B91C1C Dark=#FCA5A5}"
                                                                BorderColor="{AppThemeBinding Light=#F3B7B7 Dark=#5A2A2A}"
                                                                BorderWidth="1"
                                                                CornerRadius="8"
                                                                Padding="12,6"
                                                                HeightRequest="32" />
                                                    </Grid>
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsEditable}" Value="True">
                                                            <Setter TargetName="CellLabel" Property="IsVisible" Value="False" />
                                                            <Setter TargetName="CellEntry" Property="IsVisible" Value="True" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsDeleteAction}" Value="True">
                                                            <Setter TargetName="CellLabel" Property="IsVisible" Value="False" />
                                                            <Setter TargetName="CellEntry" Property="IsVisible" Value="False" />
                                                            <Setter TargetName="CellDeleteButton" Property="IsVisible" Value="True" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Border>

        <Border x:Name="AddTaskBorder" Grid.Row="2" Stroke="{AppThemeBinding Light=#E5E7EB Dark=#2B2F33}" BackgroundColor="{AppThemeBinding Light=#F9FAFB Dark=#14171A}" StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Offset="0,4" Opacity="0.08" Radius="10" />
            </Border.Shadow>
            <Grid Padding="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                <Label Text="{x:Static localize:Resources.todo_addtask_title}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#1F2A33 Dark=#F3F4F6}" />

                <Grid Grid.Row="1" ColumnDefinitions="2*,1*,1*,1*" ColumnSpacing="10" RowSpacing="6">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="Task Name" FontSize="11" TextColor="{AppThemeBinding Light=#6B7280 Dark=#9CA3AF}" />
                        <Entry
                            Placeholder="Task name"
                            Text="{Binding NewTaskName}"
                            TextColor="{AppThemeBinding Light=#1F2A33 Dark=#F3F4F6}"
                            PlaceholderColor="{AppThemeBinding Light=#9CA3AF Dark=#6B7280}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Plan Start" FontSize="11" TextColor="{AppThemeBinding Light=#6B7280 Dark=#9CA3AF}" />
                        <DatePicker
                            Date="{Binding NewPlanStartDate}"
                            Format="yyyy-MM-dd"
                            TextColor="{AppThemeBinding Light=#1F2A33 Dark=#F3F4F6}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="4">
                        <Label Text="Plan End" FontSize="11" TextColor="{AppThemeBinding Light=#6B7280 Dark=#9CA3AF}" />
                        <DatePicker
                            Date="{Binding NewPlanEndDate}"
                            Format="yyyy-MM-dd"
                            TextColor="{AppThemeBinding Light=#1F2A33 Dark=#F3F4F6}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3" Spacing="4">
                        <Label Text="Progress" FontSize="11" TextColor="{AppThemeBinding Light=#6B7280 Dark=#9CA3AF}" />
                        <Entry
                            Placeholder="Progress (%)"
                            Keyboard="Numeric"
                            Text="{Binding NewProgress}"
                            TextColor="{AppThemeBinding Light=#1F2A33 Dark=#F3F4F6}"
                            PlaceholderColor="{AppThemeBinding Light=#9CA3AF Dark=#6B7280}" />
                    </VerticalStackLayout>
                </Grid>

                <Button
                    Grid.Row="2"
                    Text="Add Row"
                    Command="{Binding AddRowCommand}"
                    BackgroundColor="#1F6FEB"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="42"
                    HorizontalOptions="Start" />
            </Grid>
        </Border>
    </Grid>
</ContentView>
